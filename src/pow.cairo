    0x10000000000000000000000000000000, 0x20000000000000000000000000000000, 0x40000000000000000000000000000000, 0x80000000000000000000000000000000,
];

pub fn pow2(exponent: u32) -> u128 {
    (*POWERS_OF_TWO.span()[exponent]).try_into().unwrap()
}

fn most_significant_bit(x: NonZero<u128>) -> u8 {
    let mut x: u128 = x.into();
    let mut r: u8 = 0;

    if x >= 0x10000000000000000 {
        x /= 0x10000000000000000;
        r += 64;
    }
    if x >= 0x100000000 {
        x /= 0x100000000;
        r += 32;
    }
    if x >= 0x10000 {
        x /= 0x10000;
        r += 16;
    }
    if x >= 0x100 {
        x /= 0x100;
        r += 8;
    }
    if x >= 0x10 {
        x /= 0x10;
        r += 4;
    }
    if x >= 0x4 {
        x /= 0x4;
        r += 2;
    }
    if x >= 0x2 {
        r += 1;
    }
    r
}

#[cfg(test)]
mod test {
    use super::{most_significant_bit};

    #[test]
    fn test_most_significantbit_1() {
        assert_eq!(most_significant_bit(24_u128.try_into().unwrap()), 4_u8);
        assert_eq!(most_significant_bit(340282366920938463463374607431768211455_u128.try_into().unwrap()), 127_u8);
    }
}